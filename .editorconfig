root = true

[*]
end_of_line = lf
insert_final_newline = true
indent_style = tab
tab_width = 4
charset = utf-8
trim_trailing_whitespace = true

; The YAML specification is backwards, and doesn't support tab-indentation,
; https://yaml.org/spec/1.2.2/#61-indentation-spaces
; Override the defaults to comply with the specification.
[./**.{yml,yaml}]
indent_style = space
indent_size = 2
